// WHAT THIS FILE DOES: The security guard for the database. It doesn't run
// inside this Next.js app at all — it runs on Firebase's own servers, and
// only takes effect once it's pasted into the Firebase Console and
// published (see the instructions given alongside this file). Every time
// anyone — a visitor or the admin panel — tries to read or write data,
// Firebase checks these rules first.
//
// The rules below say:
// - Anyone (including visitors who aren't signed in) can READ projects and
//   reviews, so the public site can display them.
// - Only someone signed in (the admin) can CREATE, UPDATE, or DELETE
//   projects or reviews.
// - The admin panel also keeps a small private "setup" collection (just a
//   bookkeeping marker recording whether the one-time starter-data import
//   has already run) — only the signed-in admin can read or write that.
// - Anyone (including visitors who aren't signed in) can CREATE an
//   enquiry, so the contact form works without requiring a login. But only
//   the signed-in admin can READ, UPDATE, or DELETE enquiries — a visitor
//   can send a message, but can never read anyone else's.
// - Anyone can READ homepage videos (the "How We Work" business videos, so
//   they show on the homepage), but only the signed-in admin can CREATE,
//   UPDATE, or DELETE them.
// - Anyone can READ a blog post that's marked published. A draft (not
//   published yet) can only be read by the signed-in admin — this is what
//   makes "preview before publishing" safe: only you can see a draft, even
//   if someone guessed its URL. Only the signed-in admin can CREATE,
//   UPDATE, or DELETE any blog post, draft or published.
// - Anyone can READ the site settings (a small on/off-switches document —
//   currently just whether the "Admin Login" link shows in the public
//   footer), but only the signed-in admin can change it.
// - Anything not explicitly allowed above is denied — the last rule below
//   blocks every other collection/action by default, as a safety net.
//
// IMPORTANT — these rules alone are not the whole security story. Every
// "request.auth != null" check below means "anyone with a valid signed-in
// Firebase account" — it trusts every account that exists, not just you.
// That's exactly why it's essential that your Firebase project's
// Authentication settings do NOT allow the public to create their own
// accounts (self-signup). In the Firebase Console: Authentication →
// Settings → "User actions" → make sure "Enable create (sign-up)" is
// turned OFF. With that off, the only accounts that can ever exist are
// ones you create yourself in Authentication → Users — so "anyone signed
// in" correctly means "an account I created," and you can add or remove
// admins freely from there without ever touching this file.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /projects/{projectId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /setup/{docId} {
      allow read, write: if request.auth != null;
    }

    match /enquiries/{enquiryId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    match /homepageVideos/{videoId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /blogPosts/{postId} {
      allow read: if resource.data.published == true || request.auth != null;
      allow write: if request.auth != null;
    }

    // On/off switches for the public site (currently just whether the
    // "Admin Login" link shows in the footer). Anyone can read it — the
    // public footer needs to check it — but only a signed-in admin can
    // change it.
    match /settings/{settingId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Safety net: anything not explicitly allowed above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
